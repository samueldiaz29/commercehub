# ==============================================================================
# CommerceHub — Variables de Entorno de Ejemplo (Plantilla para Desarrollo Local)
# ==============================================================================
# AVISO SOBRE CREDENCIALES Y SECRETOS:
# 1. Este archivo contiene EXCLUSIVAMENTE credenciales ficticias de ejemplo
#    destinadas a pruebas de desarrollo local en localhost.
# 2. En entornos de staging, producción o despliegues reales, NUNCA utilices
#    estas credenciales ficticias; debes aprovisionar secretos reales y seguros
#    mediante gestores de secretos dedicados o variables de entorno del host.
# 3. NUNCA agregues secretos reales, llaves privadas ni certificados a este
#    archivo ni a ningún archivo versionado en Git.
#
# INSTRUCCIONES:
# - Copia este archivo como `.env` para trabajar en local:
#     cp .env.example .env
# - NOTA: La infraestructura de contenedores (Docker Compose) se definirá en
#   fases posteriores de la infraestructura; actualmente no existe un archivo
#   docker-compose.yml en el monorepo. Los hosts por defecto apuntan a localhost.
# ==============================================================================

# ------------------------------------------------------------------------------
# Entorno General
# ------------------------------------------------------------------------------
ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# Puertos Locales de Microservicios y Clientes
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
CATALOG_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Frontend SPA (React + TypeScript)
# ------------------------------------------------------------------------------
# NOTA DE SEGURIDAD CRÍTICA PARA EL FRONTEND:
# - La SPA es un cliente público (OIDC / OAuth2 con PKCE).
# - NUNCA definas ni expongas secretos de cliente ni credenciales en el frontend.
# - NUNCA expongas `KEYCLOAK_CLIENT_SECRET` mediante variables `VITE_*`.
#   Vite incrusta en el código compilado cualquier variable que comience con VITE_*,
#   haciéndola visible para cualquier usuario en el navegador web.
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=commercehub
VITE_KEYCLOAK_CLIENT_ID=commercehub-frontend

# ------------------------------------------------------------------------------
# Persistencia — PostgreSQL (Database-per-Service: ADR-004)
# ------------------------------------------------------------------------------
# Configuración local de base de datos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Credenciales ficticias de desarrollo (reemplazar por credenciales reales en producción):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Bases de datos individuales por microservicio
CATALOG_DB_NAME=catalog_db
INVENTORY_DB_NAME=inventory_db
ORDER_DB_NAME=order_db
PAYMENT_DB_NAME=payment_db

# ------------------------------------------------------------------------------
# Mensajería Asíncrona — RabbitMQ (ADR-003 / docs/api/eventos.md)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Credenciales locales de ejemplo para desarrollo:
# NOTA: Se evitan las credenciales por defecto 'guest' / 'guest' porque RabbitMQ
# restringe el usuario 'guest' exclusivamente a conexiones de loopback (localhost),
# lo que causaría rechazo de conexión entre contenedores y procesos distribuidos.
# En producción, configurar usuarios y contraseñas reales y seguras.
RABBITMQ_DEFAULT_USER=commercehub_dev
RABBITMQ_DEFAULT_PASS=commercehub_dev_password
RABBITMQ_MAIN_EXCHANGE=commercehub.events
RABBITMQ_DLX_EXCHANGE=commercehub.dlx

# ------------------------------------------------------------------------------
# Identidad y Acceso (IAM) — Keycloak (ADR-002)
# ------------------------------------------------------------------------------
KEYCLOAK_PORT=8180
# Credenciales ficticias de administración para desarrollo local (cambiar en producción):
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_REALM=commercehub
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/commercehub
# Cliente confidencial utilizado exclusivamente por microservicios backend:
KEYCLOAK_CLIENT_ID=commercehub-backend
# Secreto ficticio de ejemplo exclusivo para consumo interno backend (NUNCA exponer en frontend):
KEYCLOAK_CLIENT_SECRET=dev-backend-client-secret-dummy

# ------------------------------------------------------------------------------
# Parámetros y Reglas de Negocio Aprobadas (docs/business-rules/reglas-transversales.md)
# ------------------------------------------------------------------------------
# Moneda oficial del sistema (RN-ORD-02)
COMMERCEHUB_BASE_CURRENCY=PEN

# Tarifa plana de envío fija por orden (RN-ORD-02: S/ 10.00)
COMMERCEHUB_SHIPPING_FLAT_RATE=10.00

# Tiempo de vida de la reserva temporal de inventario en minutos (RN-INV-01: 15 min)
COMMERCEHUB_INVENTORY_RESERVATION_TTL_MINUTES=15
